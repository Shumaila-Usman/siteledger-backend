PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/siteledger
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Upload storage — local development (default)
USE_CLOUDINARY=false

# Cloudinary (required when USE_CLOUDINARY=true — production / Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: public backend URL for local uploads (used in docs only)
# BACKEND_PUBLIC_URL=http://192.168.1.21:5000
